<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:live="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200">
    <Window.Resources>
        <local:ViewModel x:Key="viewModel"/>
        <Style x:Key="buttonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style x:Key="chartStyle" TargetType="live:CartesianChart">
            <Setter Property="DisableAnimations" Value="True"/>
            <Setter Property="Hoverable" Value="False"/>
            <Setter Property="DataTooltip" Value="{x:Null}"/>
        </Style>
    </Window.Resources>
    <Grid DataContext="{StaticResource viewModel}" Background="AliceBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="1" Grid.Row="0" Background="AliceBlue" Margin="5" CornerRadius="6">
            <StackPanel>
                <Button x:Name="btnInternalStart" Content="Start" Style="{StaticResource buttonStyle}" Click="btnInternalStart_Click"/>
                <Button x:Name="btnStop" Content="Stop" Style="{StaticResource buttonStyle}"  Background="BlanchedAlmond" Click="btnStop_Click"/>
                <Button x:Name="btnStopProgram" Content="Stop Program" Style="{StaticResource buttonStyle}" Click="btnStopProgram_Click"/>
                <Button x:Name="btnMirrorCal" Content="Mirror Calibration" Style="{StaticResource buttonStyle}" Click="btnMirrorCal_Click"/>
                <TextBox Width="100" Height="30" Text="{Binding TopGlassPosition}"/>
                <TextBox Width="100" Height="30" Text="{Binding BottomGlassPosition}"/>
                <TextBox Width="100" Height="30" Text="{Binding LaserHeight}" Background="CadetBlue"/>
                <TextBox Width="100" Height="30" Text="{Binding GlassThickness}"/>
                <Button x:Name="btnUpdateCal" Content="Update CalFile" Style="{StaticResource buttonStyle}" Click="btnUpdateCal_Click"/>
                <Button x:Name="btnRepeat" Content="Repeat" Style="{StaticResource buttonStyle}" Click="btnRepeat_Click"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="Aquamarine" Margin="5" CornerRadius="6">
            <StackPanel>
                <Button x:Name="btnTurn" Content="Turn" Style="{StaticResource buttonStyle}" Click="btnTurn_Click"/>
                <Button x:Name="btnManual" Content="Manual" Style="{StaticResource buttonStyle}" Click="btnManual_Click"/>
                <Button x:Name="btnExternal" Content="External" Style="{StaticResource buttonStyle}" Click="btnExternal_Click"/>
                <live:CartesianChart Style="{StaticResource chartStyle}" Margin="5" Height="150" Background="DarkBlue">
                    <live:CartesianChart.Series>
                        <live:LineSeries PointGeometry="{x:Null}" Values="{Binding HeightPlot}" />
                    </live:CartesianChart.Series>
                </live:CartesianChart>
            </StackPanel>
        </Border>
        <Image x:Name="crossImage" Grid.Row="0" Grid.Column="0" Margin="5" Source="{Binding CrossImage}"/>
        <live:CartesianChart Grid.Row="1" Grid.Column="0" Style="{StaticResource chartStyle}" Margin="5" Background="AntiqueWhite">
            <live:CartesianChart.Series>
                <live:LineSeries PointGeometry="{x:Null}" Foreground="Beige" Values="{Binding TopProfile}"/>
                <live:LineSeries PointGeometry="{x:Null}" Foreground="Bisque" Values="{Binding LaserProfile}"/>
            </live:CartesianChart.Series>
            <live:CartesianChart.AxisX>
                <live:Axis MinValue="0" MaxValue="1000"/>
            </live:CartesianChart.AxisX>
            <live:CartesianChart.AxisY>
                <live:Axis MinValue="-2000" MaxValue="0"/>
            </live:CartesianChart.AxisY>
        </live:CartesianChart>
    </Grid>
</Window>
